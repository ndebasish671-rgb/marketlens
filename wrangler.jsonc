{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketlens",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Optional simple rate limiting:
  // 1) npx wrangler kv namespace create RATE_LIMIT
  // 2) Uncomment below and replace the id with the returned namespace id.
  // "kv_namespaces": [{ "binding": "RL", "id": "YOUR_KV_NAMESPACE_ID" }]
}
