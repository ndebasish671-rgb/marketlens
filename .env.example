# Node backend. Copy to .env for local development; never commit real secrets.
PORT=3000

# Exact frontend origins, comma-separated, no paths or trailing slashes.
# These defaults allow a separate Vite dev server on port 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true on a public/shared backend. This disables personal Finnhub keys.
PUBLIC_DEPLOYMENT=false
# 0 for direct local access; 1 behind one trusted reverse proxy (e.g. Render).
TRUST_PROXY_HOPS=0

# Optional PRIVATE/LOCAL personal use only. The key is never sent to the browser.
FINNHUB_API_KEY=
FINNHUB_PERSONAL_USE_CONFIRMED=false
