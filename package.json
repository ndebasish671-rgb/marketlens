{
  "name": "marketlens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free stock analysis dashboard for Indian and US markets with transparent rule-based signals.",
  "scripts": {
    "dev": "node server.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server.js",
    "test": "node --test test/*.test.js",
    "dev:cf": "npm run build && wrangler dev",
    "deploy:cf": "npm run build && wrangler deploy",
    "dev:frontend": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "check:pages": "node scripts/check-pages-config.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.2.5",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "vite": "^6.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
